# Copy this file to .env and fill in real values before running the app.

# Postgres connection string used by Prisma
DATABASE_URL="postgresql://orbit:orbit@localhost:5432/orbit?schema=public"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Payments (swap in whichever UPI-compatible gateway you onboard with)
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="change-me"

# App
PORT=3000
DEFAULT_COMMISSION_PERCENT=15

# Set this in production to your deployed frontend's origin (e.g.
# https://orbit.vercel.app) so CORS isn't left wide open. Leave unset for
# local development.
FRONTEND_URL=
